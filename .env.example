# Copy to .env.local. Server-only unless prefixed NEXT_PUBLIC_.

# The shop's own domain (no trailing slash). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase — same project as the CRM: orders land in /admin/orders there.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mollie — test_… locally, live_… in production. Without it checkout returns 503.
MOLLIE_API_KEY=

# Order confirmation e-mail (Resend). Without it no e-mail is sent.
RESEND_API_KEY=
MAIL_FROM=

# Rate limiting (Upstash Redis). Without it checkout refuses orders in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Trade (B2B) catalogue. Both required, or the trade catalogue stays closed.
B2B_PASSWORD=
# 32+ random characters: openssl rand -hex 32
B2B_SECRET=
